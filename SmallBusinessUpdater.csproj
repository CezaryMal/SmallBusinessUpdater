<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SmallBusinessUpdater</AssemblyName>
    <Version>0.8.7.2</Version>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
	<Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="SmallBusinessUpdater\ExpiredUpdateWindow.xaml" />
    <Page Remove="SmallBusinessUpdater\MainWindow.xaml" />
    <Page Remove="SmallBusinessUpdater\StartupCheckWindow.xaml" />
    <Page Include="SmallBusinessUpdater\ExpiredUpdateWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="expiredupdatewindow.xaml" />
    <Page Include="SmallBusinessUpdater\MainWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mainwindow.xaml" />
    <Page Include="SmallBusinessUpdater\StartupCheckWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="startupcheckwindow.xaml" />
  </ItemGroup>
  <ItemGroup />
</Project>
