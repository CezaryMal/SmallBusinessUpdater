<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmallBusinessUpdater.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:SmallBusinessUpdater.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Small Business Updater" Width="620" Height="655" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F6F7F9" xmlns:smallbusinessupdater="clr-namespace:SmallBusinessUpdater">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFFFF" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Small Business Updater" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Static services:AppVersionService.DisplayVersion}" FontSize="24" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Top" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,10,22,1">
        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="18" Height="243">
          <StackPanel>
            <TextBlock Text="Dane licencji" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Background="#EFF6FF" CornerRadius="6" Padding="12" Margin="0,0,0,14">
              <TextBlock Text="ID, NIP i datę końca aktualizacji znajdziesz w: Inne → O programie → Licencja" Foreground="#1E3A8A" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="ID Symplex" Margin="0,0,0,5" />
            <TextBox Name="IdTextBox" Height="32" Margin="0,0,0,12" VerticalContentAlignment="Center" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.4*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="NIP" Margin="0,0,0,5" />
                <TextBox Name="NipTextBox" Height="32" VerticalContentAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Koniec aktualizacji" Margin="0,0,0,5" />
                <DatePicker Name="UpdateEndDatePicker" Height="32" VerticalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="18" Margin="0">
          <StackPanel>
            <TextBlock Text="Program" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBox Name="ProgramPathTextBox" Height="32" VerticalContentAlignment="Center" Text="C:\SB4\ksiegaw.exe" />
              <Button Name="BrowseButton" Grid.Column="2" Content="Przeglądaj..." Height="32" Click="BrowseButton_Click" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="18" Margin="0">
          <StackPanel>
            <CheckBox Name="AutoStartCheckBox" Content="Uruchamiaj updater przy starcie Windows" FontSize="14" Margin="0,0,0,10" />
            <CheckBox Name="LaunchAfterUpdateCheckBox" Content="Uruchom Small Business po zakończeniu aktualizacji" FontSize="14" />
          </StackPanel>
        </Border>
        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock>
              <Run Text="Stan: " FontWeight="SemiBold" /> <Run Text=" " /> <Run Name="StatusRun" Text="Gotowy" /></TextBlock>
            <ProgressBar Name="ProgressBar" Height="8" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <Button Name="CheckUpdatesButton" Content="Sprawdź aktualizacje" Height="38" FontWeight="SemiBold" Background="#2563EB" Foreground="#FFFFFFFF" BorderThickness="0" Click="CheckUpdatesButton_Click" />
          <Button Name="SaveButton" Grid.Column="2" Content="Zapisz" Height="38" Click="SaveButton_Click" />
          <Button Name="CloseButton" Grid.Column="4" Content="Zamknij" Height="38" Click="CloseButton_Click" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>