<Window x:Class="SmallBusinessUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SmallBusinessUpdater.Services"
        Title="Small Business Updater" Width="740" Height="760" MinWidth="600" MinHeight="540"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
<Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" CornerRadius="7" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tab" Property="BorderBrush" Value="#60A5FA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="28,22,28,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Small Business Updater" FontSize="24" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Text="Aktualizacje programu w jednym miejscu" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{x:Static services:AppVersionService.DisplayVersion}"
                 Foreground="{DynamicResource MutedBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Top" Margin="16,0,0,0" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,0,28,14">
      <RadioButton x:Name="HomeTab" Content="Aktualizacje" GroupName="Pages" Style="{StaticResource Navigation}"
                   IsChecked="True" Checked="Page_Checked" />
      <RadioButton x:Name="SettingsTab" Content="Ustawienia" GroupName="Pages" Style="{StaticResource Navigation}"
                   Margin="6,0,0,0" Checked="Page_Checked" />
      <RadioButton x:Name="DetailsTab" Content="Szczegóły" GroupName="Pages" Style="{StaticResource Navigation}"
                   Margin="6,0,0,0" Checked="Page_Checked" />
    </StackPanel>

    <ScrollViewer x:Name="HomePage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,0,28,8">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource InfoBrush}" HorizontalAlignment="Left">
              <TextBlock TextWrapping="Wrap" Text="↻" FontSize="30" Foreground="{DynamicResource InfoTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Zadbaj o aktualną wersję Small Business" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,10" />
            <TextBlock TextWrapping="Wrap" Text="Sprawdź, czy jest dostępna nowa wersja. Jeśli tak, program pobierze ją i przeprowadzi instalację."
                       Foreground="{DynamicResource MutedBrush}" FontSize="15" LineHeight="23" />
            <Border Background="{DynamicResource InfoBrush}" CornerRadius="7" Padding="14" Margin="0,20,0,0">
              <TextBlock TextWrapping="Wrap" x:Name="HomeGuidanceText" Foreground="{DynamicResource InfoTextBrush}" LineHeight="21" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="20,16">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" x:Name="HomeLastCheckText" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" x:Name="LicenseSummaryText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,0,28,8">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Dane dostępu do aktualizacji" FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="Przepisz dane z Small Business: Inne → O programie → Licencja."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="ID Symplex" Margin="0,0,0,6" />
            <TextBox x:Name="IdTextBox" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,16" />
<TextBlock x:Name="IdErrorText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,10" Visibility="Collapsed" />

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="NIP" Margin="0,0,0,6" />
                <TextBox x:Name="NipTextBox" Height="38" VerticalContentAlignment="Center" />
<TextBlock x:Name="NipErrorText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,10" Visibility="Collapsed" />

              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Koniec dostępu do aktualizacji" Margin="0,0,0,6" />
                <DatePicker DateValidationError="UpdateDate_Invalid" SelectedDateChanged="UpdateDate_Changed" x:Name="UpdateEndDatePicker" Height="38" VerticalContentAlignment="Center" />
<TextBlock x:Name="DateErrorText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Gdzie jest zainstalowany Small Business?" FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="Wskaż plik ksiegaw.exe. Zwykle znajduje się w folderze C:\SB4."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
              <TextBox x:Name="ProgramPathTextBox" Height="38" VerticalContentAlignment="Center" />
              <Button x:Name="BrowseButton" Grid.Column="2" Content="Wybierz plik…" Click="BrowseButton_Click" />
            </Grid>
<TextBlock x:Name="PathErrorText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Uruchamianie i wygląd" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18" />
            <CheckBox x:Name="AutoStartCheckBox" Margin="0,0,0,16">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Sprawdzaj aktualizacje po zalogowaniu do Windows" />
            </CheckBox>
            <CheckBox x:Name="LaunchAfterUpdateCheckBox" Margin="0,0,0,16">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Otwórz Small Business po sprawdzeniu i aktualizacji" />
            </CheckBox>
            <CheckBox x:Name="DarkThemeCheckBox" Click="DarkTheme_Click">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Ciemny wygląd aplikacji" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" Text="Zmiana wyglądu zapisuje się od razu. Pozostałe zmiany zatwierdź przyciskiem poniżej."
                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="DetailsPage" Grid.Row="2" Visibility="Collapsed"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,0,28,8">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Aktualizacja Updatera" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Sprawdź nową wersję tej aplikacji niezależnie od aktualizacji Small Business."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16" />
            <Button x:Name="SelfUpdateButton" Content="Sprawdź aktualizacje Updatera" HorizontalAlignment="Left"
                    Padding="16,10" Click="SelfUpdate_Click" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Historia i informacje o wersji" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" x:Name="InstalledBuildText" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" x:Name="InstalledDateText" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" x:Name="LastCheckText" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" x:Name="LastCheckResultText" LineHeight="22" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Pliki pomocnicze" FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="Logi pomagają wyjaśnić problem. Zachowane instalatory mogą się przydać w razie potrzeby ponownej instalacji."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18" LineHeight="22" />
            <Button Content="Otwórz folder z logami" HorizontalAlignment="Left" Padding="16,10" Click="OpenLogs_Click" Margin="0,0,0,10" />
            <Button Content="Instalatory Small Business" HorizontalAlignment="Left" Padding="16,10" Click="OpenSbInstallers_Click" Margin="0,0,0,10" />
            <Button Content="Instalatory Updatera" HorizontalAlignment="Left" Padding="16,10" Click="OpenUpdaterInstallers_Click" />
            <TextBlock TextWrapping="Wrap" Text="Program zachowuje trzy najnowsze instalatory każdego rodzaju."
                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="28,16,28,20">
      <StackPanel>
        <Border x:Name="FeedbackBorder" Background="{DynamicResource InfoBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="FeedbackTitle" Text="Gotowy do sprawdzenia" Foreground="{DynamicResource InfoTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="FeedbackDescription" Text="Kliknij „Sprawdź aktualizacje”, gdy chcesz sprawdzić nową wersję."
                       Foreground="{DynamicResource InfoTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock x:Name="StageText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <ProgressBar x:Name="ProgressBar" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
          <Button x:Name="CancelDownloadButton" Content="Anuluj sprawdzanie lub pobieranie" Height="46" FontSize="15"
                  Visibility="Collapsed" Click="CancelDownload_Click" />
          <Button x:Name="CheckUpdatesButton" Content="Sprawdź aktualizacje" Height="46" FontSize="15"
                  FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Click="CheckUpdatesButton_Click" />
          <Button x:Name="SaveButton" Content="Zapisz ustawienia" Visibility="Collapsed" Height="46" FontSize="15"
                  FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Click="SaveButton_Click" />
          <Button x:Name="CloseButton" Grid.Column="2" Content="Zamknij" Click="CloseButton_Click" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>





