<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmallBusinessUpdater.ExpiredUpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:SmallBusinessUpdater.Services" Title="Small Business Updater" Width="520" Height="330" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" xmlns:smallbusinessupdater="clr-namespace:SmallBusinessUpdater">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Small Business Updater" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Grid.Column="1" Text="{x:Static services:AppVersionService.DisplayVersion}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
      </Grid>
    </Border>
    <Grid Row="1" Margin="22,14,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="14" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20">
        <StackPanel>
          <TextBlock Name="ExpiredDateTextBlock" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" />
          <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="12">
            <TextBlock Text="Przedłuż dostęp do aktualizacji, a następnie wpisz nową datę w ustawieniach updatera." FontSize="13" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" LineHeight="19" />
          </Border>
        </StackPanel>
      </Border>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Button Name="OpenSettingsButton" Content="Otwórz ustawienia" Height="40" FontWeight="SemiBold" Background="#2563EB" Foreground="#FFFFFFFF" BorderThickness="0" Click="OpenSettingsButton_Click" />
        <Button Name="CloseButton" Grid.Column="2" Content="Zamknij" Height="40" Click="CloseButton_Click" />
      </Grid>
    </Grid>
  </Grid>
</Window>

